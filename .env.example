# PostgreSQL connection (Supabase / Neon). Optional for the web: without it the
# public site reads the curated YAML catalog in /data/seed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tetoca

# Anthropic API key, used only by the extraction pipeline (packages/extraction).
ANTHROPIC_API_KEY=

# Resend API key for email alerts (milestone 7).
RESEND_API_KEY=

# Admin panel (single admin in the MVP). Use a long random password.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie (>= 32 random chars).
ADMIN_SESSION_SECRET=

# Public base URL, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Connection pool size (1 for serverless or the local PGlite server).
DATABASE_POOL_MAX=5
